# Environment variables for Qiskit Fall Fest Website
# Copy this file to .env.local and add your values if needed

# Email service configuration (Gmail + Nodemailer)
# To get Gmail App Password:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to Google Account > Security > App Passwords
# 3. Create a new app password (select "Mail" and "Other")
# 4. Use the 16-character password below
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Example variables (uncomment and add values if needed)
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_ANALYTICS_ID=